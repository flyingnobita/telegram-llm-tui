#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."

# Check formatting
echo "Checking formatting..."
cargo fmt -- --check

# Check clippy
echo "Running clippy..."
cargo clippy -- -D warnings

# Run tests
echo "Running tests..."
cargo test

# Check markdown
echo "Checking markdown..."
if command -v markdownlint >/dev/null 2>&1; then
    markdownlint '**/*.md' --ignore 'target' --ignore 'logs' --ignore '.git'
else
    echo "Warning: markdownlint not found. Install it to enable markdown checks."
fi

echo "All checks passed!"
